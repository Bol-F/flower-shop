# Environment files and private key material must never enter an image context.
.env*
**/.env*
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12

# Local Python environments and caches.
.venv/
venv/
env/
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Generated build output and local application data.
build/
dist/
staticfiles/
media/
db.sqlite3*
*.sqlite3
*.sqlite3-*
*.log

# Local tooling and operating-system metadata.
.git/
.github/
.idea/
.vscode/
.DS_Store
Thumbs.db
